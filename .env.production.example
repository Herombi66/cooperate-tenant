# ==============================================================================
# COOPERATIVE MULTI-TENANT APPLICATION - PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env on your DigitalOcean Droplet:
#   cp .env.production.example .env
#
# Then edit the values with:
#   nano .env
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3001

# Public URLs (Replace with your actual domain or Droplet IP)
# Example with domain: https://yourdomain.com
# Example with IP: http://209.38.106.28
APP_URL=http://localhost
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost,http://localhost:3001

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL Container)
# ==============================================================================
DB_USER=postgres
DB_PASSWORD=change_this_to_a_strong_database_password
DB_NAME=imanmcs_db

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
# Generate a secure 32+ character random string (e.g. using: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_characters

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================
# Leave as /api when using the included Nginx reverse proxy
VITE_API_URL=/api

# ==============================================================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ==============================================================================
EMAIL_ENABLED=true
EMAIL_DEBUG=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=fmcksmcs@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_PASS=your-google-app-password
SMTP_FROM=fmcksmcs@gmail.com
SMTP_FROM_NAME=FMCK SMCS
EMAIL_FROM=FMCK SMCS <fmcksmcs@gmail.com>
SUPPORT_EMAIL=fmcksmcs@gmail.com
SUPPORT_PHONE=+234 810 588 0201

# Brevo (Sendinblue) API Key (Alternative email provider)
BREVO_API_KEY=
