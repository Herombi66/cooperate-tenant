<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 28px; border: 1px solid #e2e8f0; border-radius: 12px; background: #ffffff;"> 
    <div style="border-bottom: 2px solid #0F3D3D; padding-bottom: 14px; margin-bottom: 20px;">
        <h2 style="color: #0F3D3D; margin: 0 0 6px 0;">{{#if cooperative_name}}{{cooperative_name}}{{else}}FMCK SMCS{{/if}}</h2> 
        <p style="color: #64748b; margin: 0; font-size: 14px;">Administrator Password Reset Notification</p> 
    </div>
    
    <p style="font-size: 15px; color: #1e293b; line-height: 1.6;">Hello <strong>{{full_name}}</strong>,</p> 
    
    <p style="font-size: 15px; color: #334155; line-height: 1.6;">Your account password was successfully reset by <strong>{{admin_name}}</strong> on {{reset_time}}.</p> 
    
    <div style="background: #f8fafc; padding: 18px; border-left: 4px solid #0F3D3D; border-radius: 6px; margin: 24px 0;"> 
        <h3 style="margin-top: 0; color: #0F3D3D; font-size: 16px;">Your New Login Password:</h3> 
        <p style="margin: 8px 0; font-size: 16px;"><code style="background: #e2e8f0; padding: 6px 12px; border-radius: 4px; font-weight: bold; color: #0f172a; font-family: monospace;">{{new_password}}</code></p> 
    </div> 
    
    <div style="background: #fffbeb; padding: 14px 18px; border-left: 4px solid #f59e0b; border-radius: 6px; margin: 20px 0;"> 
        <p style="margin: 0; font-size: 13px; color: #92400e;"><strong>⚠️ Notice:</strong> Please log in and change your password immediately to maintain account privacy.</p> 
    </div> 
    
    <div style="text-align: center; margin: 28px 0;">
        <a href="{{login_link}}" style="display: inline-block; background: #0F3D3D; color: #ffffff; padding: 12px 28px; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 15px;">Login to Portal</a> 
    </div>
    
    <p style="font-size: 13px; color: #64748b; line-height: 1.5;">If you did not authorize or expect this reset, contact support immediately at <a href="mailto:{{support_email}}" style="color: #0F3D3D; font-weight: 500;">{{support_email}}</a>.</p> 
    
    <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 24px 0 16px 0;"> 
    <p style="font-size: 12px; color: #94a3b8; text-align: center; margin: 0;"> 
        © {{current_year}} {{#if cooperative_name}}{{cooperative_name}}{{else}}FMCK SMCS{{/if}}. All rights reserved. 
    </p> 
</div>
