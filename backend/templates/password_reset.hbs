<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 28px; border: 1px solid #e2e8f0; border-radius: 12px; background: #ffffff;"> 
    <div style="border-bottom: 2px solid #0F3D3D; padding-bottom: 14px; margin-bottom: 20px;">
        <h2 style="color: #0F3D3D; margin: 0 0 6px 0;">{{#if cooperative_name}}{{cooperative_name}}{{else}}FMCK SMCS{{/if}}</h2> 
        <p style="color: #64748b; margin: 0; font-size: 14px;">Password Reset Request</p> 
    </div>
    
    <p style="font-size: 15px; color: #1e293b; line-height: 1.6;">Hello <strong>{{first_name}}</strong>,</p> 
    
    <p style="font-size: 15px; color: #334155; line-height: 1.6;">We received a request to reset your password. Click the button below to choose a new password:</p> 
    
    <div style="text-align: center; margin: 28px 0;">
        <a href="{{reset_link}}" style="display: inline-block; background: #0F3D3D; color: #ffffff; padding: 12px 28px; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 15px;">Reset Your Password</a> 
    </div>
    
    <div style="background: #fffbeb; padding: 14px 18px; border-left: 4px solid #f59e0b; border-radius: 6px; margin: 20px 0;"> 
        <p style="margin: 0; font-size: 13px; color: #92400e;"><strong>⏱️ Note:</strong> This reset link is valid for <strong>{{#if expiry_time}}{{expiry_time}}{{else}}1 hour{{/if}}</strong>. If you did not initiate this request, you can safely ignore this email.</p> 
    </div> 
    
    <p style="font-size: 13px; color: #64748b; line-height: 1.5;">If the button above does not work, copy and paste this URL into your browser:<br><span style="color: #0F3D3D; word-break: break-all;">{{reset_link}}</span></p> 
    
    <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 24px 0 16px 0;"> 
    <p style="font-size: 12px; color: #94a3b8; text-align: center; margin: 0;"> 
        © {{#if current_year}}{{current_year}}{{else}}2026{{/if}} {{#if cooperative_name}}{{cooperative_name}}{{else}}FMCK SMCS{{/if}}. All rights reserved. 
    </p> 
</div>
